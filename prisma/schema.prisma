generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  websites  Website[]
  leads     Lead[]

  // Push Notification Settings
  pushTitleTemplate String? @default("🔥 New Lead Alert!")
  pushBodyTemplate  String? @default("You have a new lead: {{name}}")
  pushIconUrl       String? @default("/icon-192.png")
  pushCtaLabel      String? @default("View Lead")
  pushCtaUrl        String? @default("/leads")

  // SMS Auto-Reply Settings (Fast2SMS)
  smsAutoReplyEnabled Boolean @default(false)
  fast2smsApiKey      String?
  adminPhone          String?
  smsTemplate         String? @default("🔥 New Lead: {{name}} has just submitted a form!")
}

model User {
  id          String   @id @default(cuid()) // Clerk User ID ideally
  email       String   @unique
  firstName   String?
  lastName    String?
  role        String   @default("STAFF") // SUPER_ADMIN, CLIENT_ADMIN, STAFF
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  
  websiteId   String?
  website     Website?   @relation(fields: [websiteId], references: [id])

  assignedLeads Lead[] @relation("AssignedTo")
}

model Website {
  id          String   @id @default(cuid())
  name        String
  domain      String
  webhookUrl  String   @unique @default(cuid())
  apiKey      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  leads       Lead[]
  users       User[]
}

model Note {
  id         String   @id @default(cuid())
  content    String
  authorName String?
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String
  createdAt DateTime @default(now())
}

model Lead {
  id          String   @id @default(cuid())
  fullName    String
  phone       String?
  email       String?
  city        String?
  state       String?
  
  formName    String?
  source      String?
  pageUrl     String?   // URL of page where form was submitted
  pageTitle   String?   // Title of page where form was submitted
  rawFields   String?   // JSON string of all raw form fields
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  message     String?

  score       Int      @default(0)
  priority    String   @default("NORMAL") // HIGH, NORMAL, LOW
  temperature String   @default("COLD") // HOT, WARM, COLD
  status      String   @default("NEW") // NEW, CONTACTED, NO_RESPONSE, FOLLOW_UP, CONVERTED, LOST
  assignedToId String?
  callNotes    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  followUpAt   DateTime?

  // Notification Status Tracking
  smsSent     Boolean  @default(false)
  pushSent    Boolean  @default(false)

  assignedTo   User?    @relation("AssignedTo", fields: [assignedToId], references: [id])

  notes       Note[]

  websiteId   String
  website     Website  @relation(fields: [websiteId], references: [id])

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}
